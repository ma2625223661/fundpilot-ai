# Copying this file alone is insufficient: generate a unique setup token with
# python3 deploy/vps/prepare_env.py --domain your-real-domain.example
FUNDPILOT_DOMAIN=research.example.com
FUNDPILOT_PUBLIC_URL=https://research.example.com
FUNDPILOT_STATE_DIR=/app/data/cloud
FUNDPILOT_BIND_HOST=127.0.0.1
FUNDPILOT_TRUSTED_PROXIES=127.0.0.1/32
FUNDPILOT_SETUP_TOKEN=GENERATE_A_UNIQUE_32_CHARACTER_TOKEN
FUNDPILOT_REGISTRATION_OPEN=1
FUNDPILOT_AI_MODEL=gpt-6.1-sol
FUNDPILOT_AI_REASONING_EFFORT=xhigh
FUNDPILOT_AI_ENABLED=0
FUNDPILOT_AI_BASE_URL=
FUNDPILOT_AI_API_KEY=
